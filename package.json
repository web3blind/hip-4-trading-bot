{
  "name": "hip-4-telegram-bot",
  "version": "1.0.0",
  "type": "module",
  "description": "HyperLiquid HIP-4 outcome trading Telegram bot",
  "main": "src/index.js",
  "scripts": {
    "bootstrap": "node src/index.js --bootstrap",
    "start": "node src/index.js",
    "start:prod": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node scripts/run-safe-tests.js",
    "test:unit": "node scripts/run-safe-tests.js",
    "connect": "node scripts/connect-api-wallet.js",
    "connect:temporary": "node scripts/connect-agent.js",
    "migrate:prepare": "node scripts/prepare-migration-request.js",
    "migrate:export": "node scripts/export-migration-bundle.js",
    "migrate:apply": "node scripts/apply-migration-bundle.js",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:restart": "pm2 restart hip-4-telegram-bot && pm2 restart hip-4-mcp",
    "pm2:stop": "pm2 stop hip-4-mcp && pm2 stop hip-4-telegram-bot",
    "pm2:delete": "pm2 delete hip-4-mcp && pm2 delete hip-4-telegram-bot",
    "pm2:logs": "pm2 logs hip-4-telegram-bot --lines 200",
    "mcp:start": "node src/mcp-main.js",
    "pm2:mcp:start": "pm2 start ecosystem.config.cjs --only hip-4-mcp --env production",
    "pm2:mcp:restart": "pm2 restart hip-4-mcp",
    "pm2:mcp:logs": "pm2 logs hip-4-mcp --lines 200"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@msgpack/msgpack": "^3.1.3",
    "axios": "^1.7.0",
    "better-sqlite3": "^11.0.0",
    "dotenv": "^16.4.0",
    "ethers": "^5.8.0",
    "grammy": "^1.40.0",
    "https-proxy-agent": "^7.0.6",
    "hyperliquid": "^1.7.7",
    "node-cron": "^3.0.3",
    "node-machine-id": "^1.1.12",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
