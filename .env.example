# === Telegram ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# === HyperLiquid ===
# Network: testnet or mainnet
HL_NETWORK=testnet
# Private key for signing (will be encrypted in config)
# Only needed for first-time setup, then stored encrypted
# HL_PRIVATE_KEY=

# === Proxy (optional) ===
# PROXY=http://user:pass@host:port

# === Logging ===
LOG_TO_FILE=false
LOG_FILE_PATH=data/logs/bot.log

# === Workers ===
WORKER_SYNC_POSITIONS_MS=60000
WORKER_MONITOR_ORDERS_MS=30000
