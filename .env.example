# Telegram: one owner, private chats only. Never commit the completed .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# Initial network default only; persisted config.hlNetwork controls stored wallets.
HL_NETWORK=testnet

# Optional outbound HTTP CONNECT proxy. https:// preserves TLS to the proxy.
# PROXY=https://user:pass@host:8443
# OUTBOUND_HTTP_TIMEOUT_MS=20000

# Redacted logs. Relative LOG_FILE_PATH resolves from the current directory.
LOG_TO_FILE=false
# LOG_FILE_PATH=data/logs/app.log

# Optional worker intervals in milliseconds (plural WORKERS is intentional).
# WORKERS_SYNC_POSITIONS_MS=60000
# WORKERS_MONITOR_ORDERS_MS=30000
# WORKERS_MONITOR_PRICES_MS=30000

# Isolated absolute data root for offline tests; omit for normal data/.
# With HIP4_DATA_DIR set, project .env is not loaded automatically.
# HIP4_DATA_DIR=/absolute/path/to/disposable-test-data
